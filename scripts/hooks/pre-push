#!/usr/bin/env bash
# Blocks a push to aiea-dev while the public tree (../aiea) is behind.
# Drift is how the public repo went 40 days stale. Escape: SKIP_SYNC_CHECK=1 git push
set -euo pipefail

[[ "${SKIP_SYNC_CHECK:-0}" == "1" ]] && exit 0

DEV_ROOT="$(git rev-parse --show-toplevel)"
CLEAN_ROOT="${AIEA_CLEAN_ROOT:-$(cd "$DEV_ROOT/.." && pwd)/aiea}"
[[ -d "$CLEAN_ROOT" ]] || exit 0

PENDING=$(rsync -a --delete --exclude-from="$DEV_ROOT/.cleanignore" \
  --dry-run --itemize-changes "$DEV_ROOT/" "$CLEAN_ROOT/" | grep -cE '^(\*deleting|[<>ch])' || true)

if (( PENDING > 0 )); then
  echo "✗ $PENDING path(s) differ between dev and the public tree."
  echo "  Run: pixi run sync-clean   (then push ../aiea too)"
  echo "  Skip: SKIP_SYNC_CHECK=1 git push"
  exit 1
fi
