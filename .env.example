# Copy this file to .env and edit the values, then run the stack.
#   cp .env.example .env

AIEA_ENV=development

# ---------------------------------------------------------------------------
# REQUIRED: your home directory on the host machine.
# AIEA bind-mounts a few folders from here so the app can read your course
# files. Set this to your own home path, not the example.
#
#   macOS    AIEA_HOST_HOME=/Users/yourname
#   Linux    AIEA_HOST_HOME=/home/yourname
#   Windows  AIEA_HOST_HOME=/c/Users/yourname     (Git Bash / WSL style)
# ---------------------------------------------------------------------------
AIEA_HOST_HOME=/Users/yourname

# Folders AIEA is allowed to read course material from, separated by colons.
# Keep this narrow. Never point it at your whole home directory: mounting all
# of $HOME is known to crash Docker Desktop's file-sharing daemon on macOS.
AIEA_ALLOWED_ROOTS=/Users/yourname/Downloads:/Users/yourname/Documents

# ---------------------------------------------------------------------------
# Datastores. The defaults work with the bundled Postgres and Redis containers.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aiea:aiea@postgres:5432/aiea
REDIS_URL=redis://redis:6379/0

# Optional: a local LM Studio server on the host, if you use one.
LMSTUDIO_URL=http://host.docker.internal:1234
